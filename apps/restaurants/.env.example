APP_ENV=development
PORT=3001
RESTAURANT_DATABASE_URL=postgresql://restaurants:local_restaurants_only@localhost:5433/restaurants_development
IDENTITY_URL=http://localhost:3000
# At least 32 random characters. Used only by future internal order-service calls.
RESTAURANT_SERVICE_TOKEN=
MENU_CURRENCY=INR
# Use an S3-compatible private bucket. Docker supplies these through the root .env.
MENU_S3_ENDPOINT=http://localhost:8333
MENU_S3_REGION=us-east-1
MENU_S3_BUCKET=menu-photos
MENU_S3_ACCESS_KEY=
MENU_S3_SECRET_KEY=
