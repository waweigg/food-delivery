{
  "name": "food-delivery-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "worker": "node dist/worker.js",
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "test": "node --test test/*.test.cjs test/*.test.mjs",
    "provision": "node dist/provision.js"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.15",
    "dotenv": "^17.2.0",
    "express": "5.3.0",
    "nodemailer": "10.3.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
